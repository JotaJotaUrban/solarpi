[Unit]
Description=SolarPi local inverter monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=solarpi
Group=solarpi
WorkingDirectory=/home/solarpi/solar-monitor
EnvironmentFile=/home/solarpi/solar-monitor/.env
ExecStart=/home/solarpi/solar-monitor/.venv/bin/python -m solarpi.main
Restart=always
RestartSec=10
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
